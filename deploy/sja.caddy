sja.remya.top {
    encode zstd gzip
    request_body {
        max_size 100MB
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:3031
    }
    handle {
        reverse_proxy 127.0.0.1:3030
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }
}

# Retired origin: preserve the full URI and HTTP method while moving to the canonical host.
sjaplus.top {
    redir https://sja.remya.top{uri} 308
}
